# Grafana Cloud Hosted Prometheus
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-REGION.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=123456
GRAFANA_CLOUD_API_KEY=glc_xxx

# Grafana Cloud Hosted Loki
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=123456

# Existing Docker network where backend/db/redis containers run.
# Check with: docker network ls
APP_DOCKER_NETWORK=sisibibi_default

# Alloy config file.
# - Single backend: config.cloud.alloy
# - Blue/green backend: config.cloud-bluegreen.alloy
ALLOY_CONFIG_FILE=config.cloud.alloy

# Backend actuator target inside Docker network.
BACKEND_TARGET=backend:8080
BACKEND_BLUE_TARGET=backend-blue:8080
BACKEND_GREEN_TARGET=backend-green:8080

# Exporter scrape targets inside Docker network.
NODE_EXPORTER_TARGET=node-exporter:9100
REDIS_EXPORTER_TARGET=redis-exporter:9121
MYSQLD_EXPORTER_TARGET=mysqld-exporter:9104

# Exporter source targets.
REDIS_EXPORTER_ADDR=redis://redis:6379
MYSQL_EXPORTER_ADDR=db:3306
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=change-me-exporter-password

# Backend log path on host. Keep this directory readable by Docker.
BACKEND_LOG_PATH=../../backend/logs
