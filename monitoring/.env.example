GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3001
PROMETHEUS_PORT=9091

# Local exporter targets. Docker container -> host exposed ports.
REDIS_EXPORTER_ADDR=redis://host.docker.internal:26379
MYSQL_EXPORTER_ADDR=host.docker.internal:23306
MYSQL_EXPORTER_USER=root
MYSQL_EXPORTER_PASSWORD=root
